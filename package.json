{
  "name": "upanyway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Up Anyway — a cozy climbing game about being scared and doing it anyway.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vitest run tests/levels",
    "e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0"
  }
}
